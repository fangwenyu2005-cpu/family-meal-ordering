/* components/spec-selector/spec-selector.wxss */

/* Overlay */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.overlay.visible {
  opacity: 1;
  pointer-events: auto;
}

/* Sheet */
.sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background-color: #1a1a1a;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.sheet.visible {
  transform: translateY(0);
}

/* Handle */
.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.handle-bar {
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: #555;
}

/* Product header */
.product-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #2a2a2a;
}

.product-img-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
  background-color: #252525;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: linear-gradient(135deg, #2a2a2a, #1f1f1f);
}

.product-meta {
  flex: 1;
}

.product-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #eee;
  margin-bottom: 8rpx;
}

.product-price {
  font-size: 30rpx;
}

/* Spec groups */
.spec-groups {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 32rpx;
  max-height: 480rpx;
}

.spec-group {
  margin-bottom: 28rpx;
}

.spec-group-label {
  font-size: 26rpx;
  color: #ccc;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.required-mark {
  color: #e0a96d;
  font-size: 22rpx;
  margin-left: 8rpx;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-tag {
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #999;
  background-color: #252525;
  border: 1rpx solid #333;
  transition: all 0.15s;
  display: flex;
  align-items: center;
}

.option-tag:active {
  transform: scale(0.96);
}

.option-tag.selected {
  color: #e0a96d;
  background-color: rgba(224, 169, 109, 0.1);
  border-color: #e0a96d;
}

.option-delta {
  font-size: 22rpx;
  color: #e0a96d;
  margin-left: 6rpx;
}

/* Quantity row */
.quantity-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid #2a2a2a;
}

.qty-label {
  font-size: 28rpx;
  color: #ccc;
}

/* Footer */
.sheet-footer {
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #2a2a2a;
}

.btn-add-cart {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #e0a96d, #c8894f);
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}

.btn-add-cart:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-add-cart[disabled] {
  background: #333;
  color: #666;
}

.add-cart-price {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #1a1a1a !important;
}

.btn-add-cart[disabled] .add-cart-price {
  color: #666 !important;
}
