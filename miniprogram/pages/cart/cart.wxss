/* pages/cart/cart.wxss */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #0d0d0d;
}

/* ===== Header ===== */
.cart-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #222;
  flex-shrink: 0;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #eee;
}

.header-count {
  font-size: 26rpx;
  color: #999;
  margin-left: 8rpx;
}

.clear-btn {
  font-size: 26rpx;
  color: #e05252;
}

/* ===== Cart list ===== */
.cart-list {
  flex: 1;
  padding-top: 16rpx;
}

.cart-item {
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.item-main {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.item-img-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
  background-color: #252525;
}

.item-img {
  width: 100%;
  height: 100%;
}

.item-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: linear-gradient(135deg, #2a2a2a, #1f1f1f);
}

.item-info {
  flex: 1;
  overflow: hidden;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #eee;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-price-row {
  font-size: 28rpx;
}

/* Item actions */
.item-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #252525;
}

.item-subtotal {
  font-size: 30rpx;
  font-weight: 600;
}

/* ===== Checkout bar ===== */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: #1a1a2e;
  border-top: 1rpx solid #333;
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.4);
}

.checkout-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.checkout-label {
  font-size: 22rpx;
  color: #999;
}

.checkout-total {
  font-size: 40rpx;
  font-weight: 700;
}

.btn-checkout {
  background: linear-gradient(135deg, #e0a96d, #c8894f);
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  padding: 18rpx 48rpx;
  border: none;
  letter-spacing: 2rpx;
}

.btn-checkout:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* ===== Empty state ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 40rpx;
}

.empty-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 40rpx;
}
