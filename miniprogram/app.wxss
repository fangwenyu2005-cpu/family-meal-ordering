/* ===== Global Dark Theme Styles ===== */

page {
  background-color: #0d0d0d;
  color: #eee;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Reset */
view, text, image, scroll-view, swiper, button, input, navigator {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* Scrollbar hidden */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  background: transparent;
}

/* Common utility classes */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.price {
  color: #e0a96d;
  font-weight: 600;
}

.price::before {
  content: '¥';
  font-size: 22rpx;
  margin-right: 2rpx;
}

/* Card style */
.card {
  background-color: #1a1a1a;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
}

/* Accent button */
.btn-primary {
  background-color: #e0a96d;
  color: #1a1a1a;
  border: none;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  background-color: #c8894f;
  transform: scale(0.97);
}

.btn-primary[disabled] {
  background-color: #555;
  color: #999;
}

/* Outline button */
.btn-outline {
  background-color: transparent;
  color: #e0a96d;
  border: 2rpx solid #e0a96d;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  text-align: center;
}

.btn-outline:active {
  background-color: rgba(224, 169, 109, 0.1);
}

/* Small circular add button */
.btn-add {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: #e0a96d;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  border: none;
}

.btn-add:active {
  background-color: #c8894f;
  transform: scale(0.9);
}

/* Loading */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #e0a96d;
  margin: 0 8rpx;
  animation: loading-bounce 0.6s infinite alternate;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes loading-bounce {
  from { opacity: 0.3; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1.2); }
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #666;
}

.empty-state .empty-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

/* Badge */
.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  background-color: #e05252;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

/* Divider */
.divider {
  height: 1rpx;
  background-color: #2a2a2a;
  margin: 16rpx 0;
}

/* Quantity stepper */
.stepper {
  display: flex;
  align-items: center;
  border: 1px solid #444;
  border-radius: 8rpx;
  overflow: hidden;
}

.stepper .step-btn {
  width: 56rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #2a2a2a;
  color: #ccc;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
}

.stepper .step-btn:active {
  background-color: #3a3a3a;
}

.stepper .step-btn.disabled {
  color: #555;
}

.stepper .step-value {
  min-width: 64rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #eee;
  font-size: 28rpx;
  border-left: 1px solid #444;
  border-right: 1px solid #444;
}
